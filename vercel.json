{
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/servicios", "destination": "/api" },
    { "source": "/slots", "destination": "/api" },
    { "source": "/reservas", "destination": "/api" },
    { "source": "/reservas/:path*", "destination": "/api" },
    { "source": "/horarios", "destination": "/api" },
    { "source": "/dias-bloqueados", "destination": "/api" },
    { "source": "/admin/:path*", "destination": "/api" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/((?!api/).*)", "destination": "/web/$1" }
  ]
}
