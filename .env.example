# Copiar este archivo a ".env" y ajustar valores si hace falta.
# ".env" nunca se commitea (ver .gitignore) — este .example sí.

# --- Servidor HTTP ---
APP_PORT=8080

# --- PostgreSQL ---
# DB_HOST/PORT/USER/PASSWORD/NAME siguen existiendo porque docker-compose.yml
# los usa para levantar el contenedor local (ver "services: db:"). La app en
# sí (internal/api/app) ya no arma la conexión con estos campos sueltos: lee
# DATABASE_URL directo, que es el formato que entregan Neon/Railway/etc. En
# desarrollo local, DATABASE_URL se arma con los mismos valores de abajo.
#
# Puerto 5434 elegido a propósito: en esta máquina ya hay otro Postgres
# de otro proyecto usando el 5433 (docker ps lo mostró en la Fase 0).
DB_HOST=localhost
DB_PORT=5434
DB_USER=reservas_user
DB_PASSWORD=reservas_pass
DB_NAME=reservas_db
DB_SSLMODE=disable
DATABASE_URL=postgres://reservas_user:reservas_pass@localhost:5434/reservas_db?sslmode=disable

# --- Mailpit (SMTP falso para desarrollo) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@barberia.local

# --- Zona horaria del negocio (Fase 6) ---
# Todo el sistema guarda y calcula en UTC (ver docs/CONCURRENCIA.md); esta
# zona se usa solo al armar los correos, para mostrarle al cliente la hora
# en la que realmente atiende la barbería.
ZONA_HORARIA_NEGOCIO=America/Argentina/Buenos_Aires

# --- JWT (Fase 4) ---
# En producción esto tiene que ser un valor largo y aleatorio, y nunca
# subirse a git (por eso .env está en .gitignore). El de acá es solo para
# desarrollo local.
JWT_SECRET=clave-secreta-de-desarrollo-cambiar-en-produccion

# --- Cuenta de administrador (Fase 5, solo para "go run ./cmd/seed-admin") ---
ADMIN_EMAIL=admin@barberia.local
ADMIN_PASSWORD=cambiame123
